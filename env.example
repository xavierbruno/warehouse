# ============================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ============================================

# OPÇÃO 1: Usar Supabase (Recomendado para produção)
# Descomente e configure para usar Supabase:
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA_AQUI@db.jqohmvkbzpencpbyyubu.supabase.co:5432/postgres
SUPABASE_SSL=true

# OPÇÃO 2: Usar PostgreSQL local/Docker
# Se SUPABASE_DB_URL não estiver definido, usa estas variáveis:
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=warehouse_db
# DB_USER=warehouse_user
# DB_PASSWORD=warehouse_pass_2024

# ============================================
# CONFIGURAÇÃO DO BACKEND
# ============================================

# Porta do servidor
PORT=5000

# Ambiente (development, production)
NODE_ENV=production

# JWT Secret (altere em produção!)
JWT_SECRET=change-this-secret-key-in-production-use-strong-random-string
JWT_EXPIRES_IN=24h

# CORS Origin (deixe * para desenvolvimento, especifique em produção)
CORS_ORIGIN=*

# ============================================
# CONFIGURAÇÃO DO FRONTEND
# ============================================

# URL da API (usado no build do frontend)
VITE_API_URL=http://localhost:5000/api

# ============================================
# NOTAS
# ============================================
# 1. Copie este arquivo para .env e configure as variáveis
# 2. NUNCA commite o arquivo .env no Git
# 3. Para Supabase, você só precisa definir SUPABASE_DB_URL
# 4. Para PostgreSQL local, não defina SUPABASE_DB_URL

