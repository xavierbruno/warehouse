{
  "name": "warehouse-schedule-system",
  "version": "1.0.0",
  "description": "Sistema de controle de escala de trabalho para warehouse",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --port $PORT --host 0.0.0.0",
